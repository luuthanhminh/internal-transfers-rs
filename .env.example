# Copy to .env for `make run` / `make test` (the Makefile loads it).
DATABASE_URL=postgres://transfers:transfers@localhost:56432/transfers
BIND_ADDR=127.0.0.1:8080
DB_MAX_CONNECTIONS=20
DB_ACQUIRE_TIMEOUT_SECS=5
RUST_LOG=info
# Apply migrations on startup (false when they run as a release step: `internal-transfers migrate`).
RUN_MIGRATIONS=true
# text | json
LOG_FORMAT=text
