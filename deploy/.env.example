# Copy to deploy/.env on the server (never commit it): cp deploy/.env.example deploy/.env
# deploy/deploy.sh rewrites IMAGE on every release.

# Signed image from the Release workflow, by digest (shown on the run summary).
IMAGE=ghcr.io/luuthanhminh/internal-transfers-rs@sha256:replace-with-release-digest

# Public hostname routed to this host by the Cloudflare tunnel.
DOMAIN=transfers.minhlt.com

# Generate once: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Cloudflare Zero Trust -> Networks -> Tunnels -> (tunnel) -> token.
TUNNEL_TOKEN=change-me
